# Copy this file to .env on the server and fill in real values.
# .env is gitignored - never commit the real one.

SPRING_PROFILES_ACTIVE=prod

# Native MySQL on the host (not the dockerized easycom-mysql on 3307).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=construction_material_db
DB_USERNAME=construction_btp
DB_PASSWORD=CHANGE_ME

# Generate distinct random values for each (e.g. `openssl rand -base64 64`).
# Never reuse the dev values from application-local.properties.
JWT_SECRET=CHANGE_ME
LICENSE_SECRET=CHANGE_ME

# Password for the seeded superadmin account, changed at first login anyway -
# still must not be guessable, since the source is public.
SUPERADMIN_INITIAL_PASSWORD=CHANGE_ME

# Public origin the frontend is served from (used if the backend is ever
# reached directly, e.g. via Swagger, bypassing the nginx same-origin proxy).
CORS_ALLOWED_ORIGINS=http://SERVER_IP:8082
